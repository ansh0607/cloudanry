[TEMPLATE]
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Demo mode: run the whole app with ZERO credentials (in-memory DB + local media).
# All AI outputs are disabled in this mode; deterministic checks still run.
DEMO_MODE=0

# --- AI (Groq) ---
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional model overrides (defaults shown)
GROQ_MODEL_VISION=qwen/qwen3.8-27b
GROQ_MODEL_SUPPORTING=openai/gpt-oss-120b
# NOTE: llama-3.3-70b-versatile was retired from Groq (404); openai/gpt-oss-20b is the current lightweight text model
GROQ_MODEL_ADVERSARIAL=openai/gpt-oss-20b

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# WARNING: never paste real credentials into this file — it is tracked by git.

# --- Firebase (service account JSON, single-line string in .env) ---
# Firebase console → Project settings → Service accounts → Generate new private key
# Put the entire JSON content on ONE line (newlines as \n) or use FIREBASE_CREDENTIALS_PATH instead.
# NEVER paste the JSON (or its private key) into this tracked file — keep it only in `.env`
# or in a file outside the repo referenced by FIREBASE_CREDENTIALS_PATH.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=
